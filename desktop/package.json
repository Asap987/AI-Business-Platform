{
  "name": "kasora-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "KASORA AI desktop shell: a secure window around the KASORA AI web app (Windows and macOS).",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ai.kasora.desktop",
    "productName": "KASORA AI",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "extraResources": [{ "from": "app-config.json", "to": "app-config.json" }],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true },
    "mac": { "category": "public.app-category.business", "target": ["dmg"], "hardenedRuntime": true, "extendInfo": { "NSMicrophoneUsageDescription": "KASORA AI uses the microphone for test calls you start." } },
    "publish": null
  }
}
