# Copy to .env (never commit .env). Keys are read on the server only.
ENVIRONMENT=development

# --- OpenAI (intelligence) ---
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-6.1-terra
OPENAI_FAST_MODEL=gpt-6-luna

# --- ElevenLabs (speech) ---
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v3_live
ELEVENLABS_STT_FALLBACK_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_EXPRESSIVE_MODEL=eleven_v3

# --- Voice sessions ---
VOICE_SESSION_MAX_SECONDS=900
VOICE_SILENCE_TIMEOUT_SECONDS=30
VOICE_MIN_LANGUAGE_PROBABILITY=0.7
VOICE_ALLOW_PROTOTYPE_LANGUAGES=true
VOICE_MAX_CONCURRENT_SESSIONS_PER_BUSINESS=10

# --- Recording (off by default) ---
VOICE_STORE_AUDIO=false
VOICE_REQUIRE_RECORDING_CONSENT=true
VOICE_AUDIO_RETENTION_DAYS=0
VOICE_TRANSCRIPT_RETENTION_DAYS=90

# --- Cost estimates: fill from the providers' CURRENT price lists. Left empty,
# estimates report "missing rate" instead of guessing. JSON, example:
# VOICE_PRICING={"as_of":"YYYY-MM-DD","source_note":"where the rates came from","elevenlabs_stt_usd_per_hour":"0","elevenlabs_tts_usd_per_1k_chars":"0","openai_models":{"gpt-6.1-terra":{"input_usd_per_mtok":"0","output_usd_per_mtok":"0"}}}

# --- Paid live provider tests (cost money; opt in explicitly) ---
RUN_LIVE_PROVIDER_TESTS=false
